{
	"phpVersion": "8.2",
	"mappings": {
		"wp-content/plugins/bp-tracker": "./backend"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_DISPLAY": false,
		"WP_DEBUG_LOG": "/tmp/wp-errors.log",
		"SCRIPT_DEBUG": true
	},
	"env": {
		"tests": {
			"mappings": {
				"wp-content/plugins/bp-tracker": "./backend"
			},
			"config": {
				"WP_DEBUG": false,
				"WP_DEBUG_DISPLAY": false,
				"WP_DEBUG_LOG": "/tmp/wp-errors.log"
			}
		}
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp plugin activate bp-tracker && wp-env run tests-cli wp plugin activate bp-tracker"
	}
}
