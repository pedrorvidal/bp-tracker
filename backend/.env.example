# Local configuration for the bp-tracker plugin. Copy to .env (never commit
# .env). Constants defined in wp-config.php and real environment variables
# take precedence over this file.

# HMAC secret for access tokens, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
BP_TRACKER_JWT_SECRET=

# The only origin allowed to call the API cross-origin (the Vite dev server).
BP_TRACKER_FRONTEND_ORIGIN=http://localhost:5173
