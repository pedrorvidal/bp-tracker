# Local configuration for the bp-tracker plugin. Copy to .env (never commit
# .env). Constants defined in wp-config.php and real environment variables
# take precedence over this file.

# HMAC secret for access tokens, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
BP_TRACKER_JWT_SECRET=

# The only origin allowed to call the API cross-origin (the Vite dev server).
BP_TRACKER_FRONTEND_ORIGIN=http://localhost:5173

# Reverse proxies / load balancers in front of WordPress, as comma-separated
# IPs or CIDR ranges (e.g. 10.0.0.0/8,2001:db8::/32). Only requests arriving
# from these addresses have their X-Forwarded-For header trusted to find the
# client IP for rate limiting. Leave empty when WordPress faces clients
# directly (as in local dev): the header can be forged by anyone.
BP_TRACKER_TRUSTED_PROXIES=
